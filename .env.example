# Copy to .env.local. Browse the app via http://localhost:3000 only (never 127.0.0.1):
# the PKCE verifier cookie is per-host.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key printed by `supabase status` (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google OAuth secrets go in supabase/.env (git-ignored), read by `supabase start`:
#   SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
#   SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
# Google Cloud (Web application client):
#   Authorized redirect URI:      http://127.0.0.1:54321/auth/v1/callback
#   Authorized JavaScript origin: http://localhost:3000
